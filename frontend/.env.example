# robsond or its BFF/reverse-proxy origin. Same-origin deployments can leave
# this empty. Never place credentials in a PUBLIC_ variable.
PUBLIC_ROBSON_API_BASE=http://localhost:8080

# Browser authentication mode:
# - oidc: public Authorization Code + PKCE client; access token is memory-only.
# - bff:  HttpOnly session cookie owned by the BFF; no token reaches JavaScript.
PUBLIC_ROBSON_WEB_AUTH_MODE=oidc

# RBX Identity (ZITADEL) public-client metadata. The client id is intentionally
# blank until the Robson client is provisioned. Google is selected inside
# ZITADEL; Robson never accepts a Google token directly.
PUBLIC_RBX_OIDC_ISSUER=https://auth.merovelis.com
PUBLIC_RBX_OIDC_CLIENT_ID=
PUBLIC_RBX_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
PUBLIC_RBX_OIDC_SCOPES=openid profile email
PUBLIC_RBX_OIDC_ORG_ID=375992756025229511
# Provision the Robson API project and place its real ZITADEL project id here.
PUBLIC_RBX_OIDC_PROJECT_ID=
# Optional: set only after the real Google IdP id is known. Otherwise the RBX
# organization login policy must expose Google as its only login method.
PUBLIC_RBX_OIDC_GOOGLE_IDP_ID=

# BFF mode only. The endpoint starts OIDC and sets the HttpOnly session after
# the callback. It may be relative to PUBLIC_ROBSON_API_BASE.
PUBLIC_RBX_BFF_LOGIN_URL=/oidc/login
