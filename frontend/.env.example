# PUBLIC_ROBSON_API_BASE — injected at build time for static deployment.
# For local dev, set to your robsond API endpoint.
PUBLIC_ROBSON_API_BASE=http://localhost:8080

# PUBLIC_GOOGLE_WEB_CLIENT_ID (ADR-0054) — Google OAuth Web client id used
# by Google Identity Services (https://accounts.google.com/gsi/client) on
# /login. This is a public, build-time value (GIS client ids are meant to
# be visible in the browser; the security boundary is robsond's server-side
# ID token verification, not secrecy of this id). Must match one of
# robsond's ROBSON_GOOGLE_WEB_CLIENT_ID / ROBSON_GOOGLE_CLI_CLIENT_ID.
# Registered 2026-09-11 in the rbx-systems GCP project (authorized origins:
# robson.rbx.ia.br, robson.rbxsystems.ch, localhost:5173).
PUBLIC_GOOGLE_WEB_CLIENT_ID=844825462148-233fhbl236qj9gu3nc7r57rf3gs6gel5.apps.googleusercontent.com
