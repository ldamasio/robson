# PUBLIC_ROBSON_API_BASE — injected at build time for static deployment.
# For local dev, set to your robsond API endpoint.
PUBLIC_ROBSON_API_BASE=http://localhost:8080
# Transitional local-only login. Production builds should set this to false.
PUBLIC_ROBSON_ALLOW_LEGACY_LOGIN=true
# RBX Identity public-client values. Never put a client secret here.
# PUBLIC_RBX_OIDC_ISSUER=https://auth.rbx.ia.br
# PUBLIC_RBX_OIDC_CLIENT_ID=REPLACE_WITH_REGISTERED_CLIENT_ID
# PUBLIC_RBX_OIDC_REDIRECT_URI=https://robson.rbx.ia.br/login
# PUBLIC_RBX_OIDC_SCOPES=openid profile email REPLACE_WITH_ROBSON_AUDIENCE_AND_ROLE_SCOPES
