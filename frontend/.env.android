# Public build-time configuration for the internal MOB-P1 Android client.
# No credentials or bearer tokens belong in this file.
PUBLIC_ROBSON_API_BASE=https://api.robson.rbx.ia.br
PUBLIC_ROBSON_CLIENT_MODE=mobile-readonly
PUBLIC_ROBSON_ALLOW_LEGACY_LOGIN=false
PUBLIC_RBX_OIDC_ISSUER=https://auth.rbx.ia.br
PUBLIC_RBX_OIDC_CLIENT_ID=
PUBLIC_RBX_OIDC_REDIRECT_URI=br.ia.rbx.robson://oauth/callback
PUBLIC_RBX_OIDC_SCOPES=openid profile email
