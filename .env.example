# DATABASE

POSTGRES_HOST=localhost
POSTGRES_DATABASE=rbsdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5450

# RBX Identity / ZITADEL (required together in production)
# Registration metadata is intentionally not populated with guessed values.
# ROBSON_OIDC_ISSUER=https://auth.merovelis.com
# ROBSON_OIDC_AUDIENCE=
# ROBSON_OIDC_JWKS_URI=https://auth.merovelis.com/oauth/v2/keys
# ROBSON_OIDC_ALLOWED_CLIENT_IDS=
# One explicit authorization binding: <zitadel-organization-id>=<tenant-uuid>
# ROBSON_OIDC_TENANT_BINDING=
# ROBSON_OIDC_ALLOWED_SUBJECTS=

# Tenant-scoped projection boundary (required in production)
# PROJECTION_TENANT_ID=

# Development-only escape hatch. Auth-disabled mode is rejected unless this
# is exactly true and ROBSON_API_HOST is loopback.
# ROBSON_API_HOST=127.0.0.1
# ROBSON_ALLOW_INSECURE_DEV_AUTH=true
